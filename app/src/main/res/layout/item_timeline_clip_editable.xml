<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="2dp"
    android:background="@android:color/transparent">

    <!-- Active selection outline -->
    <View
        android:id="@+id/activeBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_clip_active_border"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Clip Thumbnail Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/clipCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/color_surface_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/thumbnailStripContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Left Trim Handle -->
    <ImageView
        android:id="@+id/leftTrimHandle"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_left_trim_handle"
        android:scaleType="fitXY"
        android:paddingHorizontal="6dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Right Trim Handle -->
    <ImageView
        android:id="@+id/rightTrimHandle"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_right_trim_handle"
        android:scaleType="fitXY"
        android:paddingHorizontal="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Display Name -->
    <TextView
        android:id="@+id/clipName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:background="@color/color_badge_background"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Clip Duration/Speed Badge -->
    <TextView
        android:id="@+id/clipDurationText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:textColor="@color/color_primary"
        android:textSize="10sp"
        android:background="@color/color_badge_background"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
