<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0C0E"
    tools:context=".feature.projectdetail.ProjectDetailFragment">

    <!-- ── 1. Top Header Action Bar ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0D0C0E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="4dp"
            android:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back" />

        <ImageView
            android:id="@+id/btnUndo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:src="@drawable/ic_undo"
            android:padding="4dp"
            android:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_undo" />

        <ImageView
            android:id="@+id/btnRedo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:src="@drawable/ic_redo"
            android:padding="4dp"
            android:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_redo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Resolution Selector Dropdown -->
        <LinearLayout
            android:id="@+id/btnResolution"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_resolution_dropdown"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080P"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="270"
                android:tint="@color/white"
                android:contentDescription="Dropdown Arrow" />
        </LinearLayout>

        <!-- Export button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:backgroundTint="#00D4AA"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="16dp"
            android:text="Export"
            android:textColor="#0D0C0E"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <!-- More vertical menu dots -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:src="@drawable/ic_plus"
            android:rotation="45"
            android:padding="4dp"
            android:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More Menu" />

    </LinearLayout>

    <!-- ── 2. Video Preview Section (Top Half) ─────────────────────────────── -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBar"
        app:layout_constraintBottom_toTopOf="@id/midControlBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <SurfaceView
            android:id="@+id/previewSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Left overlay control panel -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="12dp"
            android:background="#801C1B1F"
            android:orientation="vertical"
            android:padding="6dp"
            android:elevation="4dp">
            <ImageView
                android:id="@+id/btnOverlayGrid"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_grid"
                android:layout_margin="6dp"
                android:tint="@color/white"
                android:contentDescription="Grid Overlay" />
            <ImageView
                android:id="@+id/btnOverlayCrop"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_crop"
                android:layout_margin="6dp"
                android:tint="@color/white"
                android:contentDescription="Crop Overlay" />
            <ImageView
                android:id="@+id/btnOverlayAspect"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_aspect_ratio"
                android:layout_margin="6dp"
                android:tint="@color/white"
                android:contentDescription="Aspect Ratio Overlay" />
        </LinearLayout>

        <!-- Bottom-Left Duration overlay badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="#801C1B1F"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:elevation="4dp">
            <ImageView
                android:id="@+id/btnOverlayPlay"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_play"
                android:tint="@color/white"
                android:contentDescription="Play/Pause overlay" />
            <TextView
                android:id="@+id/txtOverlayTimecode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="00:00 / 00:00"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom-Right Expand overlay -->
        <ImageView
            android:id="@+id/btnOverlayExpand"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="#801C1B1F"
            android:src="@drawable/ic_expand"
            android:padding="6dp"
            android:tint="@color/white"
            android:elevation="4dp"
            android:contentDescription="Fullscreen Expand" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/bufferingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/color_primary" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="visible"
            app:indicatorColor="@color/color_primary" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/color_on_surface_variant"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ── 3. Mid Controls Bar ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/midControlBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#0D0C0E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Add Media Button -->
        <ImageView
            android:id="@+id/btnMidAdd"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_resolution_dropdown"
            android:src="@drawable/ic_plus"
            android:padding="6dp"
            android:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add Clip" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Media playback navigation row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Skip Previous Edit -->
            <ImageView
                android:id="@+id/btnSkipPrev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/white"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Skip Prev" />

            <!-- Frame Previous -->
            <ImageView
                android:id="@+id/btnFramePrev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_frame_previous"
                android:tint="@color/white"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Frame Prev" />

            <!-- Solid Main Play/Pause Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayPause"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="8dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_play"
                app:iconSize="20dp"
                app:iconTint="@color/white"
                android:contentDescription="@string/cd_play_pause" />

            <!-- Frame Next -->
            <ImageView
                android:id="@+id/btnFrameNext"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_frame_next"
                android:tint="@color/white"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Frame Next" />

            <!-- Skip Next Edit -->
            <ImageView
                android:id="@+id/btnSkipNext"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/white"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Skip Next" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Magnet (magnetic snap) -->
        <ImageView
            android:id="@+id/btnMagnet"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_magnet"
            android:tint="@color/white"
            android:layout_marginHorizontal="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Magnet Snap" />

        <!-- Keyframe button -->
        <ImageView
            android:id="@+id/btnKeyframe"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_keyframe"
            android:tint="@color/white"
            android:layout_marginHorizontal="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add Keyframe" />

        <!-- Expand timeline -->
        <ImageView
            android:id="@+id/btnExpand"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_timeline_expand"
            android:tint="@color/white"
            android:layout_marginHorizontal="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Fullscreen Timeline" />

    </LinearLayout>

    <!-- ── 4. Bottom Editor Bar (Bottom Half) ────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_editor_bottom_bar"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_md"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Scrollable Multi-track Timeline section -->
        <LinearLayout
            android:id="@+id/timelineSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Track labels (fixed column on left) -->
            <LinearLayout
                android:layout_width="@dimen/timeline_track_label_width"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/timeline_ruler_height"
                android:showDividers="beginning|middle"
                android:divider="@drawable/timeline_divider">

                <include
                    android:id="@+id/labelVideo"
                    layout="@layout/layout_track_label" />
                <include
                    android:id="@+id/labelAudio"
                    layout="@layout/layout_track_label" />
                <include
                    android:id="@+id/labelText"
                    layout="@layout/layout_track_label" />
                <include
                    android:id="@+id/labelOverlay"
                    layout="@layout/layout_track_label" />
            </LinearLayout>

            <!-- Scrollable content -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <HorizontalScrollView
                    android:id="@+id/timelineHorizontalScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Ruler -->
                        <com.beatsandbeyond.video_editor.feature.projectdetail.view.TimelineRulerView
                            android:id="@+id/timelineRuler"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/timeline_ruler_height" />

                        <!-- Track Lanes -->
                        <LinearLayout
                            android:id="@+id/tracksContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/color_outline_variant"
                            android:showDividers="beginning|middle"
                            android:divider="@drawable/timeline_divider">

                            <!-- Video Track Lane -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/videoTrackLane"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/timeline_track_height"
                                android:background="#1A191C" />

                            <!-- Audio Track Lane -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/audioTrackLane"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/timeline_track_height"
                                android:background="#0D2220" />

                            <!-- Text Track Lane -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/textTrackLane"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/timeline_track_height"
                                android:background="#221C14" />

                            <!-- Overlay Track Lane -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/overlayTrackLane"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/timeline_track_height"
                                android:background="#1C1422" />

                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

            </FrameLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/color_outline_variant" />

        <!-- Bottom context action bar (visible when clip selected) -->
        <include
            android:id="@+id/contextToolbar"
            layout="@layout/partial_editor_bottom_toolbar"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Centered Playhead Line Overlay (Constrained to timelineSection to prevent layout height measurement cycles) -->
    <com.beatsandbeyond.video_editor.feature.projectdetail.view.PlayheadView
        android:id="@+id/playheadView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/timelineSection"
        app:layout_constraintBottom_toBottomOf="@id/timelineSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
