<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/timeline_track_label_width"
    android:layout_height="@dimen/timeline_track_height"
    android:background="@color/color_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Row 1: Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/trackIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:tint="@color/color_on_surface" />

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/color_on_surface" />
    </LinearLayout>

    <!-- Row 2: Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_play"
            android:tint="@color/color_on_surface_variant" />

        <ImageView
            android:id="@+id/btnLock"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_pause"
            android:tint="@color/color_on_surface_variant" />
    </LinearLayout>
</LinearLayout>
