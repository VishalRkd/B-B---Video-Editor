<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md"
    android:background="@color/color_surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sheet_filter_title"
        android:textColor="@color/color_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabFilter"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sheet_tab_filter" />

        <Button
            android:id="@+id/tabAdjust"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/sheet_tab_adjust" />
    </LinearLayout>

    <!-- Filter presets -->
    <LinearLayout
        android:id="@+id/filterPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="vertical" />

    <!-- Adjust controls -->
    <LinearLayout
        android:id="@+id/adjustControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.slider.Slider
            android:id="@+id/brightnessSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-1"
            android:valueTo="1"
            android:stepSize="0.05"
            android:value="0"
            app:haloColor="@color/color_primary"
            app:thumbColor="@color/color_primary"
            app:trackColorActive="@color/color_primary"
            app:labelBehavior="visible"
            android:contentDescription="@string/sheet_brightness" />

        <com.google.android.material.slider.Slider
            android:id="@+id/contrastSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="2"
            android:stepSize="0.05"
            android:value="1"
            app:haloColor="@color/color_primary"
            app:thumbColor="@color/color_primary"
            app:trackColorActive="@color/color_primary"
            app:labelBehavior="visible"
            android:contentDescription="@string/sheet_contrast" />

        <com.google.android.material.slider.Slider
            android:id="@+id/saturationSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="2"
            android:stepSize="0.05"
            android:value="1"
            app:haloColor="@color/color_primary"
            app:thumbColor="@color/color_primary"
            app:trackColorActive="@color/color_primary"
            app:labelBehavior="visible"
            android:contentDescription="@string/sheet_saturation" />
    </LinearLayout>

</LinearLayout>
