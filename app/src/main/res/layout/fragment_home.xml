<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".feature.home.HomeFragment">

    <!-- ── App Bar ───────────────────────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingTop="?attr/actionBarSize"
            app:menu="@menu/menu_home"
            app:title="@string/app_name"
            app:titleTextColor="@color/color_on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Content below app bar ─────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Loading Indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/color_primary"
            tools:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/emptyStateIcon"
                android:layout_width="@dimen/icon_size_hero"
                android:layout_height="@dimen/icon_size_hero"
                android:alpha="0.85"
                android:contentDescription="@string/cd_app_logo"
                android:src="@drawable/ic_launcher_foreground"
                android:tint="@color/color_primary" />

            <TextView
                android:id="@+id/emptyStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/home_empty_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/color_on_surface" />

            <TextView
                android:id="@+id/emptyStateSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/home_empty_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/color_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewProject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/new_project"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="@dimen/corner_xl"
                app:icon="@android:drawable/ic_input_add"
                app:iconTint="@color/color_on_primary" />

        </LinearLayout>

        <!-- Project Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/projectGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_sm"
            android:scrollbars="vertical"
            android:visibility="gone"
            tools:listitem="@layout/item_project_card"
            tools:visibility="gone" />

    </FrameLayout>

    <!-- ── FAB — shown when projects exist ───────────────────────────────────── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewProject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_lg"
        android:contentDescription="@string/new_project"
        android:src="@android:drawable/ic_input_add"
        android:visibility="gone"
        app:backgroundTint="@color/color_primary"
        app:tint="@color/color_on_primary"
        tools:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
